POSTGRES_USER=juez
POSTGRES_PASSWORD=cambiar-contraseña
POSTGRES_DB=juez_virtual
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+psycopg://juez:cambiar-contraseña@localhost:5432/juez_virtual
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
MAIL_FROM=Juez virtual <no-reply@juez-virtual.local>
# Cuenta de administrador: la crea `uv run python -m app.db.create_admin` (idempotente).
# Una vez creada, ADMIN_PASSWORD puede borrarse de este fichero.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar-contraseña
